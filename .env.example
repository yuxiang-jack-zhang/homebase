# Placeholders only. Copy to .env.local and fill in. Never commit real keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-key
# Edge functions only: 1 = deterministic keyword fake model instead of Claude. Refused unless SUPABASE_URL is local.
# For served tests put just this line in supabase/functions/.env.test (git-ignored).
ANTHROPIC_FAKE=0
# Mobile app (apps/mobile/.env, git-ignored). Same local stack values as above; a physical phone needs the Mac's LAN IP, not 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
